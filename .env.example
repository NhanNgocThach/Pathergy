# Local development uses SQLite. Cloud deployment must replace this with the
# pooled PostgreSQL connection string copied from Neon.
DATABASE_URL=sqlite:///./pathergy.db

# Generate two different values with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
AUTH_TOKEN_HASH_SECRET=

# Comma-separated exact browser origins allowed to call FastAPI. Never use *.
# In Render, set this to the deployed Vercel origin (for example,
# https://pathergy.vercel.app).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Development mode exposes single-use verification/reset URLs in responses.
AUTH_DEVELOPMENT_MODE=true
AUTH_DEVELOPMENT_BASE_URL=http://localhost:3000
AUTH_RATE_LIMIT_PER_MINUTE=30
